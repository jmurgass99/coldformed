{
  "name": "@coldformed/web",
  "version": "1.0.0",
  "description": "Ultralight VanJS + Three.js + WebAssembly 3D cold-formed steel FSM signature curve & buckling viewer with StripGeometryMapping",
  "type": "module",
  "scripts": {
    "dev": "vite --open",
    "build": "vite build",
    "preview": "vite preview --open",
    "test": "vitest run",
    "build:wasm": "emcc ./src/solver/cpp/fsmKernel.cpp -o ./src/solver/cpp/built/fsmKernel.wasm -O3 -s STANDALONE_WASM --no-entry -s EXPORTED_FUNCTIONS=_plateBucklingStress,_winterRhoUnchecked"
  },
  "dependencies": {
    "three": "^0.170.0",
    "vanjs-core": "^1.5.2"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vitest": "^2.1.5"
  }
}
